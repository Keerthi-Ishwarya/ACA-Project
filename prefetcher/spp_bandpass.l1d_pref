#include "cache.h"
#include <cassert>

#define SPP_TRACKER_COUNT 256
#define PHT_SIZE 512
#define RECENT_PREFETCH_SIZE 256
#define EPOCH_ACCESSES 16384

// Local-only Band-Pass filter thresholds (adapted from Sridharan et al., TACO 2017)
// High-pass threshold: 21% (below which prefetch accuracy is low -> drop 15/16)
// Low-pass threshold: 50% (above which prefetch rate is excessive -> drop 1/2)
#define HP_THRESHOLD 0.21f
#define LP_THRESHOLD 0.50f

// class to track memory access patterns for individual Pointers
class SPP_TRACKER {
public:
    uint64_t ip;
    uint64_t last_cl_addr;
    int64_t last_stride;

    int uniform_confidence;
    int64_t stride_hist[3];
    uint32_t lru;

    SPP_TRACKER() {
        ip = 0;
        last_cl_addr = 0;
        last_stride = 0;
        uniform_confidence = 0;
        for (int i = 0; i < 3; i++) stride_hist[i] = 0;
        lru = 0;
    };

    uint32_t get_signature() {
        uint32_t sig = ((stride_hist[0] & 0x7F) << 14) | ((stride_hist[1] & 0x7F) << 7) | (stride_hist[2] & 0x7F);
        return sig % PHT_SIZE;
    }
};

class PHT_ENTRY {
public:
    int64_t next_stride;
    PHT_ENTRY() {
        next_stride = 0;
    }
};

SPP_TRACKER spp_trackers[NUM_CPUS][SPP_TRACKER_COUNT];
PHT_ENTRY pht[NUM_CPUS][PHT_SIZE];

uint64_t recent_prefetches[NUM_CPUS][RECENT_PREFETCH_SIZE];
int recent_prefetch_idx[NUM_CPUS] = {0};

int spp_issued_prefetches[NUM_CPUS] = {0};
int spp_useful_prefetches[NUM_CPUS] = {0};
int spp_total_demand_accesses[NUM_CPUS] = {0};
uint32_t epoch_cand_prefetches[NUM_CPUS] = {0};
int spp_current_degree[NUM_CPUS] = {0};

// Band-Pass Controller state per CPU (local-only per-core band-pass)
enum BandPassMode { MODE_IN_BAND = 0, MODE_HIGH_PASS_DROP = 1, MODE_LOW_PASS_DROP = 2 };
BandPassMode bp_mode[NUM_CPUS];
float bp_current_pf[NUM_CPUS] = {0.0f};
uint32_t bp_hp_drop_counter[NUM_CPUS] = {0};
uint32_t bp_lp_drop_counter[NUM_CPUS] = {0};

// ROI Statistics (all gated by all_warmup_complete > NUM_CPUS)
uint64_t bp_stat_cand_prefetches[NUM_CPUS] = {0};
uint64_t bp_stat_issued_prefetches[NUM_CPUS] = {0};
uint64_t bp_stat_hp_dropped[NUM_CPUS] = {0};
uint64_t bp_stat_lp_dropped[NUM_CPUS] = {0};
uint64_t bp_stat_epochs_in_band[NUM_CPUS] = {0};
uint64_t bp_stat_epochs_high_pass[NUM_CPUS] = {0};
uint64_t bp_stat_epochs_low_pass[NUM_CPUS] = {0};

uint64_t spp_roi_demands[NUM_CPUS] = {0};
uint64_t spp_roi_prefetches[NUM_CPUS] = {0};
uint64_t spp_roi_useful[NUM_CPUS] = {0};

static inline bool should_drop_bandpass(uint32_t cpu)
{
    bool in_roi = (all_warmup_complete > NUM_CPUS);
    if (in_roi)
        bp_stat_cand_prefetches[cpu]++;
    epoch_cand_prefetches[cpu]++;

    if (bp_mode[cpu] == MODE_HIGH_PASS_DROP) {
        // High-pass filter: drop 15 in 16 (issue only 1 in 16)
        if ((bp_hp_drop_counter[cpu]++ % 16) != 0) {
            if (in_roi) bp_stat_hp_dropped[cpu]++;
            return true;
        }
    } else if (bp_mode[cpu] == MODE_LOW_PASS_DROP) {
        // Low-pass filter: drop 1 in 2 (issue only 1 in 2)
        if ((bp_lp_drop_counter[cpu]++ % 2) != 0) {
            if (in_roi) bp_stat_lp_dropped[cpu]++;
            return true;
        }
    }
    return false;
}

void CACHE::l1d_prefetcher_initialize() 
{
    std::cout << "--------------------------------------------------------" << std::endl;
    std::cout << "   CPU  " << cpu << " Band-Pass Controlled Prefetcher (BP-SPP)   " << std::endl;
    std::cout << "   Band: [" << HP_THRESHOLD << ", " << LP_THRESHOLD << "]" << std::endl;
    std::cout << "--------------------------------------------------------" << std::endl;

    for (int i = 0; i < SPP_TRACKER_COUNT; i++) {
        spp_trackers[cpu][i].lru = i;
    }
    for (int i = 0; i < RECENT_PREFETCH_SIZE; i++) {
        recent_prefetches[cpu][i] = 0;
    }
    recent_prefetch_idx[cpu] = 0;
    spp_issued_prefetches[cpu] = 0;
    spp_useful_prefetches[cpu] = 0;
    spp_total_demand_accesses[cpu] = 0;
    epoch_cand_prefetches[cpu] = 0;
    spp_current_degree[cpu] = 4;

    bp_mode[cpu] = MODE_IN_BAND;
    bp_current_pf[cpu] = 0.35f; // initial default within band
    bp_hp_drop_counter[cpu] = 0;
    bp_lp_drop_counter[cpu] = 0;
    bp_stat_cand_prefetches[cpu] = 0;
    bp_stat_issued_prefetches[cpu] = 0;
    bp_stat_hp_dropped[cpu] = 0;
    bp_stat_lp_dropped[cpu] = 0;
    bp_stat_epochs_in_band[cpu] = 0;
    bp_stat_epochs_high_pass[cpu] = 0;
    bp_stat_epochs_low_pass[cpu] = 0;
    spp_roi_demands[cpu] = 0;
    spp_roi_prefetches[cpu] = 0;
    spp_roi_useful[cpu] = 0;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;
    bool in_roi = (all_warmup_complete > NUM_CPUS);
    if (in_roi)
        spp_roi_demands[cpu]++;

    // check if current demand access hits a recently issued prefetch
    for (int i = 0; i < RECENT_PREFETCH_SIZE; i++) {
        if (recent_prefetches[cpu][i] == cl_addr) {
            spp_useful_prefetches[cpu]++;
            if (in_roi)
                spp_roi_useful[cpu]++;
            recent_prefetches[cpu][i] = 0;
            break;
        }
    }

    // Epoch-based Band-Pass Prefetch-Fraction calculation and mode update
    // Both D (all L1D load accesses) and P (candidate L1D prefetches) are measured
    // at the same L1D interface; using candidates avoids artificial feedback lock-in.
    spp_total_demand_accesses[cpu]++;
    if (spp_total_demand_accesses[cpu] >= EPOCH_ACCESSES) {
        uint32_t total_req = spp_total_demand_accesses[cpu] + epoch_cand_prefetches[cpu];
        float pf = (total_req > 0) ? ((float)epoch_cand_prefetches[cpu] / total_req) : 0.0f;
        bp_current_pf[cpu] = pf;

        if (pf < HP_THRESHOLD) {
            // Below the band: low prefetch usefulness/accuracy -> High-Pass Filter active (drop 15/16)
            bp_mode[cpu] = MODE_HIGH_PASS_DROP;
            if (in_roi) bp_stat_epochs_high_pass[cpu]++;
        } else if (pf > LP_THRESHOLD) {
            // Above the band: excessive prefetch rate -> Low-Pass Filter active (drop 1/2)
            bp_mode[cpu] = MODE_LOW_PASS_DROP;
            if (in_roi) bp_stat_epochs_low_pass[cpu]++;
        } else {
            // Inside the pass-band: balanced and accurate -> full pass-through
            bp_mode[cpu] = MODE_IN_BAND;
            if (in_roi) bp_stat_epochs_in_band[cpu]++;
        }

        spp_issued_prefetches[cpu] = 0;
        spp_useful_prefetches[cpu] = 0;
        spp_total_demand_accesses[cpu] = 0;
        epoch_cand_prefetches[cpu] = 0;
    }

    // Find the SPP tracker for current ip
    int index = -1;
    for (index = 0; index < SPP_TRACKER_COUNT; index++) {
        if (spp_trackers[cpu][index].ip == ip) break;
    }

    // ip not found then allocate new entry using lru
    if (index == SPP_TRACKER_COUNT) {
        for (index = 0; index < SPP_TRACKER_COUNT; index++) {
            if (spp_trackers[cpu][index].lru == (SPP_TRACKER_COUNT - 1)) break;
        }
        spp_trackers[cpu][index].ip = ip;
        spp_trackers[cpu][index].last_cl_addr = cl_addr;
        spp_trackers[cpu][index].last_stride = 0;
        spp_trackers[cpu][index].uniform_confidence = 0;
        spp_trackers[cpu][index].stride_hist[0] = 0;
        spp_trackers[cpu][index].stride_hist[1] = 0;
        spp_trackers[cpu][index].stride_hist[2] = 0;

        for (int i = 0; i < SPP_TRACKER_COUNT; i++) {
            if (spp_trackers[cpu][i].lru < spp_trackers[cpu][index].lru) spp_trackers[cpu][i].lru++;
        }
        spp_trackers[cpu][index].lru = 0;
        return;
    }

    int64_t stride = cl_addr - spp_trackers[cpu][index].last_cl_addr;
    if (stride == 0) return;

    // update uniform stride confidence
    if (stride == spp_trackers[cpu][index].last_stride) {
        spp_trackers[cpu][index].uniform_confidence++;
        if (spp_trackers[cpu][index].uniform_confidence > 3) spp_trackers[cpu][index].uniform_confidence = 3;
    } else {
        spp_trackers[cpu][index].uniform_confidence--;
        if (spp_trackers[cpu][index].uniform_confidence < 0) spp_trackers[cpu][index].uniform_confidence = 0;
    }

    // update PHT with the previous signature mapping to newly observed stride
    uint32_t prev_sig = spp_trackers[cpu][index].get_signature();
    pht[cpu][prev_sig].next_stride = stride;

    // shift stride history
    spp_trackers[cpu][index].stride_hist[0] = spp_trackers[cpu][index].stride_hist[1];
    spp_trackers[cpu][index].stride_hist[1] = spp_trackers[cpu][index].stride_hist[2];
    spp_trackers[cpu][index].stride_hist[2] = stride;

    // Issue prefetches based on confidence and filtered by Band-Pass
    if (spp_trackers[cpu][index].uniform_confidence >= 2) {
        uint64_t curr_pf_cl = cl_addr;
        for (int i = 0; i < spp_current_degree[cpu]; i++) {
            curr_pf_cl += spp_trackers[cpu][index].last_stride;

            if ((curr_pf_cl >> (LOG2_PAGE_SIZE - LOG2_BLOCK_SIZE)) != (cl_addr >> (LOG2_PAGE_SIZE - LOG2_BLOCK_SIZE)))
                break;

            if (should_drop_bandpass(cpu)) continue;

            uint64_t pf_address = curr_pf_cl << LOG2_BLOCK_SIZE;
            if (MSHR.occupancy < (MSHR.SIZE >> 1))
                prefetch_line(ip, addr, pf_address, FILL_L1, 0);
            else
                prefetch_line(ip, addr, pf_address, FILL_L2, 0);

            spp_issued_prefetches[cpu]++;
            if (in_roi) {
                bp_stat_issued_prefetches[cpu]++;
                spp_roi_prefetches[cpu]++;
            }
            recent_prefetches[cpu][recent_prefetch_idx[cpu]] = curr_pf_cl;
            recent_prefetch_idx[cpu] = (recent_prefetch_idx[cpu] + 1) % RECENT_PREFETCH_SIZE;
        }
    } else {
        uint32_t current_sig = spp_trackers[cpu][index].get_signature();
        uint64_t curr_pf_cl = cl_addr;
        int64_t temp_hist[3] = {spp_trackers[cpu][index].stride_hist[0], spp_trackers[cpu][index].stride_hist[1], spp_trackers[cpu][index].stride_hist[2]};

        for (int i = 0; i < spp_current_degree[cpu]; i++) {
            int64_t pred_stride = pht[cpu][current_sig].next_stride;
            if (pred_stride == 0) break;

            curr_pf_cl += pred_stride;
            if ((curr_pf_cl >> (LOG2_PAGE_SIZE - LOG2_BLOCK_SIZE)) != (cl_addr >> (LOG2_PAGE_SIZE - LOG2_BLOCK_SIZE)))
                break;

            // Advance lookahead history and signature before drop check so dropped candidates
            // do not stall the PHT lookahead chain on the same signature.
            temp_hist[0] = temp_hist[1];
            temp_hist[1] = temp_hist[2];
            temp_hist[2] = pred_stride;
            current_sig = ((temp_hist[0] & 0x7F) << 14) | ((temp_hist[1] & 0x7F) << 7) | (temp_hist[2] & 0x7F);
            current_sig = current_sig % PHT_SIZE;

            if (should_drop_bandpass(cpu)) continue;

            uint64_t pf_address = curr_pf_cl << LOG2_BLOCK_SIZE;
            if (MSHR.occupancy < (MSHR.SIZE >> 1))
                prefetch_line(ip, addr, pf_address, FILL_L1, 0);
            else
                prefetch_line(ip, addr, pf_address, FILL_L2, 0);

            spp_issued_prefetches[cpu]++;
            if (in_roi) {
                bp_stat_issued_prefetches[cpu]++;
                spp_roi_prefetches[cpu]++;
            }
            recent_prefetches[cpu][recent_prefetch_idx[cpu]] = curr_pf_cl;
            recent_prefetch_idx[cpu] = (recent_prefetch_idx[cpu] + 1) % RECENT_PREFETCH_SIZE;
        }
    }

    spp_trackers[cpu][index].last_cl_addr = cl_addr;
    spp_trackers[cpu][index].last_stride = stride;

    for (int i = 0; i < SPP_TRACKER_COUNT; i++) {
        if (spp_trackers[cpu][i].lru < spp_trackers[cpu][index].lru)
            spp_trackers[cpu][i].lru++;
    }
    spp_trackers[cpu][index].lru = 0;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
    return;
}

void CACHE::l1d_prefetcher_final_stats()
{
    double pf_frac = (spp_roi_demands[cpu] + spp_roi_prefetches[cpu] > 0) ?
        ((double)spp_roi_prefetches[cpu] / (spp_roi_demands[cpu] + spp_roi_prefetches[cpu])) : 0.0;
    double accuracy = (spp_roi_prefetches[cpu] > 0) ?
        ((double)spp_roi_useful[cpu] / spp_roi_prefetches[cpu]) : 0.0;
    std::cout << "CPU " << cpu << " BP-SPP Final Stats: Degree=" << spp_current_degree[cpu]
              << " Demands=" << spp_roi_demands[cpu]
              << " Prefetches=" << spp_roi_prefetches[cpu]
              << " Prefetch_Fraction=" << pf_frac
              << " Useful=" << spp_roi_useful[cpu]
              << " Accuracy=" << accuracy << std::endl;
    std::cout << "  Band-Pass Filter Details:"
              << " Candidate=" << bp_stat_cand_prefetches[cpu]
              << " Issued=" << bp_stat_issued_prefetches[cpu]
              << " HP_Dropped=" << bp_stat_hp_dropped[cpu]
              << " LP_Dropped=" << bp_stat_lp_dropped[cpu]
              << " Epochs_InBand=" << bp_stat_epochs_in_band[cpu]
              << " Epochs_HP=" << bp_stat_epochs_high_pass[cpu]
              << " Epochs_LP=" << bp_stat_epochs_low_pass[cpu] << std::endl;
}